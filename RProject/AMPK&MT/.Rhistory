single_gene_boxplot <- function(gene=g){
box_plot_data <- data.frame(gene = t(unname(exp1[g,])),group=rt$group)
ggplot(data = box_plot_data,
aes(x=group,gene=g,fill=group))+
geom_boxplot()+
geom_point(position = "jitter")
}
