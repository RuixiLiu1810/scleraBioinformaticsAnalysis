pheatmap(gsva,
annotation_col=rt,
color = colorRampPalette((c("blue","white","red")))(100),
cluster_cols = F,
cluster_rows = T,
show_colnames = F,
show_rownames = T ,
border_color = 'black',#不加边框 NA
